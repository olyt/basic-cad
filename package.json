{
    "name": "basic-cad",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "author": "Oleksandr Lytovchenko",
    "engines": {
        "node": ">=24.15.0 <25",
        "npm": ">=11.12.1 <12"
    },
    "packageManager": "npm@11.12.1",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "npm run typecheck && vite build",
        "preview": "vite preview --host 127.0.0.1",
        "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json && npm run typecheck:pure",
        "typecheck:pure": "node scripts/check-pure.mjs",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run typecheck && npm run lint && npm run format:check",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "vue": "3.5.43"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "24.19.0",
        "@vitejs/plugin-vue": "6.0.9",
        "eslint": "10.11.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-vue": "10.11.1",
        "prettier": "3.9.9",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.1",
        "vite": "8.3.1",
        "vitest": "5.0.2",
        "vue-eslint-parser": "10.4.1",
        "vue-tsc": "3.3.11"
    }
}
